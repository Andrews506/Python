class Node:
    def __init__(self, enrollment_id, name, course):
        self.enrollment_id = enrollment_id
        self.name = name
        self.course = course
        self.left = None
        self.right = None
        self.height = 1


class AVLEnrollmentSystem:
    def get_height(self, node):
        if not node:
            return 0
        return node.height

    def get_balance(self, node):
        if not node:
            return 0
        return self.get_height(node.left) - self.get_height(node.right)

    def right_rotate(self, y):
        x = y.left
        T2 = x.right
        
        
        x.right = y
        y.left = T2
        
        
        y.height = 1 + max(self.get_height(y.left), self.get_height(y.right))
        x.height = 1 + max(self.get_height(x.left), self.get_height(x.right))
        
        return x

    def left_rotate(self, x):
        y = x.right
        T2 = y.left
        
        
        y.left = x
        x.right = T2
        x.height = 1 + max(self.get_height(x.left), self.get_height(x.right))
        y.height = 1 + max(self.get_height(y.left), self.get_height(y.right))
        
        return y

    def insert(self, root, enrollment_id, name, course):
        
        if not root:
            return Node(enrollment_id, name, course)
        
        if enrollment_id < root.enrollment_id:
            root.left = self.insert(root.left, enrollment_id, name, course)
        elif enrollment_id > root.enrollment_id:
            root.right = self.insert(root.right, enrollment_id, name, course)
        else:
            print(f"Error: Enrollment ID {enrollment_id} already exists. Duplicate IDs are not allowed.")
            return root

        
        root.height = 1 + max(self.get_height(root.left), self.get_height(root.right))

        
        balance = self.get_balance(root)

        
        if balance > 1 and enrollment_id < root.left.enrollment_id:
            return self.right_rotate(root)

       
        if balance < -1 and enrollment_id > root.right.enrollment_id:
            return self.left_rotate(root)

        
        if balance > 1 and enrollment_id > root.left.enrollment_id:
            root.left = self.left_rotate(root.left)
            return self.right_rotate(root)

        
        if balance < -1 and enrollment_id < root.right.enrollment_id:
            root.right = self.right_rotate(root.right)
            return self.left_rotate(root)

        return root

    def min_value_node(self, node):
        current = node
        while current.left is not None:
            current = current.left
        return current

    def delete(self, root, enrollment_id):
        
        if not root:
            print(f"Error: Enrollment ID {enrollment_id} not found.")
            return root

        if enrollment_id < root.enrollment_id:
            root.left = self.delete(root.left, enrollment_id)
        elif enrollment_id > root.enrollment_id:
            root.right = self.delete(root.right, enrollment_id)
        else:
            
            if root.left is None:
                print(f"-> Student with ID {enrollment_id} deleted successfully.")
                return root.right
            elif root.right is None:
                print(f"-> Student with ID {enrollment_id} deleted successfully.")
                return root.left

            
            temp = self.min_value_node(root.right)

            
            root.enrollment_id = temp.enrollment_id
            root.name = temp.name
            root.course = temp.course

            
            root.right = self.delete(root.right, temp.enrollment_id)

        if not root:
            return root

        
        root.height = 1 + max(self.get_height(root.left), self.get_height(root.right))
          
        
        balance = self.get_balance(root)

        
        if balance > 1 and self.get_balance(root.left) >= 0:
            return self.right_rotate(root)

        
        if balance > 1 and self.get_balance(root.left) < 0:
            root.left = self.left_rotate(root.left)
            return self.right_rotate(root)

        
        if balance < -1 and self.get_balance(root.right) <= 0:
            return self.left_rotate(root)

        
        if balance < -1 and self.get_balance(root.right) > 0:
            root.right = self.right_rotate(root.right)
            return self.left_rotate(root)

        return root

    def search(self, root, enrollment_id):
        if not root or root.enrollment_id == enrollment_id:
            return root
        if root.enrollment_id < enrollment_id:
            return self.search(root.right, enrollment_id)
        return self.search(root.left, enrollment_id)

    def inorder_traversal(self, root):
        res = []
        if root:
            res.extend(self.inorder_traversal(root.left))
            res.append({
                'Enrollment ID': root.enrollment_id,
                'Name': root.name,
                'Course': root.course
            })
            res.extend(self.inorder_traversal(root.right))
        return res

    def count_enrollments(self, root):
        if not root:
            return 0
        return 1 + self.count_enrollments(root.left) + self.count_enrollments(root.right)



system = AVLEnrollmentSystem()
root = None

while True:
    
    print("----- AVL ENROLLMENT SYSTEM -----")
    
    print("1. Insert Student")
    print("2. Delete Student")
    print("3. Search Student")
    print("4. Traverse All Enrollments (Sorted)")
    print("5. Count Total Enrollments")
    print("6. Exit")
    
    choice = input("\nEnter your choice (1-6): ").strip()
    
    if choice == '1':
        try:
            eid = int(input("Enter Enrollment ID: "))
            name = input("Enter Student Name: ")
            course = input("Enter Course Name: ")
            root = system.insert(root, eid, name, course)
            print("-> Student enrolled successfully!")
        except ValueError:
            print("Invalid format. Enrollment ID must be an integer.")
            
    elif choice == '2':
        try:
            eid = int(input("Enter Enrollment ID to delete: "))
            root = system.delete(root, eid)
        except ValueError:
            print("Invalid format. Enrollment ID must be an integer.")
            
    elif choice == '3':
        try:
            eid = int(input("Enter Enrollment ID to search: "))
            result_node = system.search(root, eid)
            if result_node:
                print(f"Found Student -> ID: {result_node.enrollment_id}, Name: {result_node.name}, Course: {result_node.course}")
            else:
                print(f"Student with ID {eid} not found.")
        except ValueError:
            print("Invalid format. Enrollment ID must be an integer.")
            
    elif choice == '4':
        print("\n--- All Current Enrollments (Sorted by ID) ---")
        enrollments = system.inorder_traversal(root)
        if not enrollments:
            print("No students enrolled.")
        else:
            for student in enrollments:
                print(f"ID: {student['Enrollment ID']} | Name: {student['Name']} | Course: {student['Course']}")
                
    elif choice == '5':
        total = system.count_enrollments(root)
        print(f"\nTotal Number of Enrollments: {total}")
        
    elif choice == '6':
        print("Exiting AVL Enrollment System. Goodbye!")
        break
    else:
        print("Invalid choice. Please select an option between 1 and 6.")
